# ─────────────────────────────────────────────────────────────────────────────
# Pointerworks — Ethereum challenge (Sepolia testnet)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env`, fill, then `set -a && . .env && set +a` before forge commands.
# `.env` is gitignored. NEVER commit a real DEPLOYER_KEY.

# Sepolia RPC — free tier at https://alchemy.com (create app → "Ethereum Sepolia")
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Throwaway private key for deploy (NEVER your real wallet). Fund ~0.05 SepETH.
DEPLOYER_KEY=0xYOUR_THROWAWAY_PRIVATE_KEY

# Etherscan API key for contract verification — free signup at etherscan.io/apis
ETHERSCAN_KEY=YOUR_ETHERSCAN_API_KEY

# (Client-side) Deployed contract address. Paste after `forge create` output.
# Consumed by `scripts/web3/ethers_glue.js` + web3_bridge.gd.
POINTERWORKS_CONTRACT=0x0000000000000000000000000000000000000000
