[autoload]

SceneSwitcher="*res://scripts/autoload/scene_switcher.gd"
Progress="*res://scripts/autoload/progress.gd"
AudioBus="*res://scripts/autoload/audio_bus.gd"
Settings="*res://scripts/autoload/settings.gd"
